# .env にコピーして使う。.env はコミットしない（apps/api/.gitignore で除外）。秘密値はここに書かない。

# Supabase。プロジェクトURLだけを書き、/rest/v1/ などのパスを付けない。
# ローカル：supabase status の API_URL（http://127.0.0.1:54321）と SECRET_KEY
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=

# 外部API（02・03で使用）
GEMINI_API_KEY=
GOOGLE_MAPS_SERVER_API_KEY=

# CORSで許可するフロントのオリジン。カンマ区切り。* は不可
ALLOWED_ORIGINS=http://localhost:8081

# 店員回答の半減期（日、仮設定）。AIの仮の票（AI_PRIOR_WEIGHT_*）は08の決定で廃止
STORE_ANSWER_HALF_LIFE_DAYS=30

# アカウント用トークン（P1）
AUTH_JWT_SECRET=
ACCOUNT_TOKEN_TTL_HOURS=24

# レート制限の保存先。memory はローカル専用（Vercel上では起動を拒否）。公開環境は upstash。
RATE_LIMIT_BACKEND=memory
# Upstash Redis の REST URL・トークン（Vercel Marketplace連携の KV_REST_API_URL / KV_REST_API_TOKEN でも可）
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
