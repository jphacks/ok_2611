# Values prefixed with EXPO_PUBLIC_ are inlined into the browser bundle. Never put secrets here.
# Browser key for the Maps JavaScript API (⑥ map). It is public by design: restrict it in Google Cloud to
# HTTP referrers (your front-end origins) and to the Maps JavaScript API only. Leave blank to hide the map;
# the nearby list, restaurant selection, and Skip still work. Never put the server Places key here.
EXPO_PUBLIC_GOOGLE_MAPS_BROWSER_API_KEY=
# Optional. Map ID for advanced markers. Blank uses Google's DEMO_MAP_ID, which is for testing only.
EXPO_PUBLIC_GOOGLE_MAPS_MAP_ID=
# Optional. FastAPI base URL including /api/v1. Defaults to https://meelyze-api.vercel.app/api/v1 (src/api/endpoints.ts).
EXPO_PUBLIC_API_BASE_URL=
